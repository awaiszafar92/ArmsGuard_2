@{
	ViewData["Title"] = "Dashboard";
	Layout = "_AdminLayout";
}
<div id="adminAccessMessage" class="alert alert-warning" role="alert" hidden>This dashboard is available through the administrator demo login. <a asp-controller="Account" asp-action="Login">Go to login</a>.</div>
<section id="overview" class="dashboard-section"><div class="dashboard-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p>Sample administrative activity for the ArmsGuard frontend demonstration.</p></div><span class="demo-badge">DEMO DATA</span></div>
	<div class="summary-grid"><article class="summary-card"><span>Catalog entries</span><strong>4</strong><small>Fictional reference records</small></article><article class="summary-card"><span>Registered users</span><strong>128</strong><small>Sample count only</small></article><article class="summary-card"><span>Pending applications</span><strong id="pendingApplications">7</strong><small>Sample records only</small></article><article class="summary-card"><span>Pending enquiries</span><strong id="pendingEnquiries">3</strong><small>Sample records only</small></article></div>
</section>
<section id="application-management" class="dashboard-section admin-panel"><div class="panel-heading"><div><p class="eyebrow">REVIEW QUEUE</p><h2>Recent applications</h2></div><input class="form-control table-search" type="search" placeholder="Search applications" data-table-search="applicationsTable" aria-label="Search applications" /></div><div class="table-responsive"><table class="table admin-table" id="applicationsTable"><thead><tr><th>Reference</th><th>Applicant</th><th>Category</th><th>Submitted</th><th>Status</th><th>Action</th></tr></thead><tbody>
<tr><td>AG-2026-1048</td><td>Jordan Lee</td><td>General information</td><td>May 18, 2026</td><td><select class="form-select form-select-sm status-select"><option>Submitted</option><option>Under Review</option><option>Further Information Required</option><option>Approved for Further Processing</option><option>Rejected</option></select></td><td><button class="btn btn-sm btn-outline-navy" data-view-record="AG-2026-1048" data-details="General information request. Sample record; no documents are stored.">View</button></td></tr>
<tr><td>AG-2026-1052</td><td>Casey Morgan</td><td>Sporting use information</td><td>May 17, 2026</td><td><select class="form-select form-select-sm status-select"><option>Under Review</option><option>Submitted</option><option>Further Information Required</option><option>Approved for Further Processing</option><option>Rejected</option></select></td><td><button class="btn btn-sm btn-outline-navy" data-view-record="AG-2026-1052" data-details="Sporting use information request. Sample record; status changes are temporary.">View</button></td></tr>
<tr><td>AG-2026-1061</td><td>Riley Patel</td><td>Renewal information</td><td>May 15, 2026</td><td><select class="form-select form-select-sm status-select"><option>Further Information Required</option><option>Submitted</option><option>Under Review</option><option>Approved for Further Processing</option><option>Rejected</option></select></td><td><button class="btn btn-sm btn-outline-navy" data-view-record="AG-2026-1061" data-details="Renewal information request. Sample record with no real applicant data.">View</button></td></tr>
</tbody></table></div><div class="form-feedback" id="adminFeedback" role="status" aria-live="polite"></div></section>
<section id="enquiries" class="dashboard-section admin-panel"><div class="panel-heading"><div><p class="eyebrow">INFORMATION REQUESTS</p><h2>Recent enquiries</h2></div><input class="form-control table-search" type="search" placeholder="Search enquiries" data-table-search="enquiriesTable" aria-label="Search enquiries" /></div><div class="table-responsive"><table class="table admin-table" id="enquiriesTable"><thead><tr><th>Reference</th><th>Sample item</th><th>Request date</th><th>Status</th><th>Details</th></tr></thead><tbody><tr><td>ENQ-2026-032</td><td>Atlas Compact</td><td>May 19, 2026</td><td><span class="status-pill status-review">Pending review</span></td><td><button class="btn btn-sm btn-outline-navy" data-view-record="ENQ-2026-032" data-details="Simulated enquiry for administrative and legal review only. No transaction is available.">View</button></td></tr><tr><td>ENQ-2026-031</td><td>Ridgefield Sport</td><td>May 16, 2026</td><td><span class="status-pill status-available">Information shared</span></td><td><button class="btn btn-sm btn-outline-navy" data-view-record="ENQ-2026-031" data-details="Sample informational enquiry; no sale or transfer took place.">View</button></td></tr></tbody></table></div></section>
<section id="catalog-management" class="dashboard-section admin-panel"><div class="panel-heading"><div><p class="eyebrow">REFERENCE DATA</p><h2>Catalog management</h2></div><a class="btn btn-outline-navy btn-sm" asp-controller="Weapon" asp-action="Catalog">View public catalog</a></div><p class="muted-copy">Sample catalog entries are static frontend data. Management controls are demonstrations and do not persist changes.</p><div class="management-list"><div><strong>Atlas Compact</strong><span>Handguns · Northstar Arms</span><button class="btn btn-sm btn-outline-navy" data-catalog-action="Atlas Compact">Simulate edit</button></div><div><strong>Ridgefield Sport</strong><span>Rifles · Meridian Sporting</span><button class="btn btn-sm btn-outline-navy" data-catalog-action="Ridgefield Sport">Simulate edit</button></div><div><strong>Heritage Field</strong><span>Shotguns · Cedar &amp; Vale</span><button class="btn btn-sm btn-outline-navy" data-catalog-action="Heritage Field">Simulate edit</button></div><div><strong>Legacy 1874</strong><span>Historical Firearms · Oldstone Works</span><button class="btn btn-sm btn-outline-navy" data-catalog-action="Legacy 1874">Simulate edit</button></div></div></section>
<section id="user-management" class="dashboard-section admin-panel"><div class="panel-heading"><div><p class="eyebrow">DEMO ONLY</p><h2>User management</h2></div></div><p class="muted-copy">User names and counts are fictitious examples. Account management will require a secure backend in a future phase.</p><div class="management-list"><div><strong>Jordan Lee</strong><span>Sample user · No account data stored</span><button class="btn btn-sm btn-outline-navy" data-user-action="Jordan Lee">View demo profile</button></div><div><strong>Casey Morgan</strong><span>Sample user · No account data stored</span><button class="btn btn-sm btn-outline-navy" data-user-action="Casey Morgan">View demo profile</button></div></div></section>
<div class="modal fade" id="recordModal" tabindex="-1" aria-labelledby="recordModalTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="recordModalTitle">Sample record</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body" id="recordModalBody"></div><div class="modal-footer"><button type="button" class="btn btn-navy" data-bs-dismiss="modal">Close</button></div></div></div></div>
