@{
	ViewData["Title"] = "Marketplace information";
}
<section class="page-hero page-hero-compact"><div class="container"><p class="eyebrow">INFORMATION ONLY</p><h1>Marketplace enquiries</h1><p>Review demonstration listings and submit a simulated request for administrative and legal review.</p></div></section>
<section class="section-space"><div class="container"><div class="notice-bar mb-4">No sales, payments, delivery, ownership transfer, or transaction processing is available on ArmsGuard.</div>
	<div class="catalog-toolbar"><div class="search-wrap"><label class="visually-hidden" for="marketSearch">Search listings</label><input id="marketSearch" class="form-control" type="search" placeholder="Search sample listings" /></div><select class="form-select" id="marketCategory" aria-label="Filter listings"><option value="">All categories</option><option>Handguns</option><option>Rifles</option><option>Shotguns</option><option>Historical Firearms</option></select></div>
	<div class="row g-4 mt-2" id="marketGrid">
		<div class="col-md-6 col-lg-4 market-item" data-category="Handguns" data-search="Atlas Compact Northstar Arms"><article class="catalog-card"><img src="/images/catalog-handgun.svg" alt="Illustration for Atlas Compact" /><div class="catalog-card-body"><span class="status-pill status-review">Review required</span><h2>Atlas Compact</h2><p>Northstar Arms · Handguns · Sample listing</p><p>Demonstration information record. Availability and eligibility are not verified.</p><div class="card-actions"><a class="btn btn-outline-navy" asp-controller="Weapon" asp-action="Details" asp-route-id="atlas-compact">View details</a><button type="button" class="btn btn-gold" data-enquiry="Atlas Compact">Submit enquiry</button></div></div></article></div>
		<div class="col-md-6 col-lg-4 market-item" data-category="Rifles" data-search="Ridgefield Sport Meridian Sporting"><article class="catalog-card"><img src="/images/catalog-rifle.svg" alt="Illustration for Ridgefield Sport" /><div class="catalog-card-body"><span class="status-pill status-available">Information only</span><h2>Ridgefield Sport</h2><p>Meridian Sporting · Rifles · Sample listing</p><p>Fictional record provided only to demonstrate enquiry review workflows.</p><div class="card-actions"><a class="btn btn-outline-navy" asp-controller="Weapon" asp-action="Details" asp-route-id="ridgefield-sport">View details</a><button type="button" class="btn btn-gold" data-enquiry="Ridgefield Sport">Submit enquiry</button></div></div></article></div>
		<div class="col-md-6 col-lg-4 market-item" data-category="Historical Firearms" data-search="Legacy 1874 Oldstone Works"><article class="catalog-card"><img src="/images/catalog-historical.svg" alt="Illustration for Legacy 1874" /><div class="catalog-card-body"><span class="status-pill status-review">Review required</span><h2>Legacy 1874</h2><p>Oldstone Works · Historical Firearms · Sample listing</p><p>Classification can differ by jurisdiction; consult appropriate local authorities.</p><div class="card-actions"><a class="btn btn-outline-navy" asp-controller="Weapon" asp-action="Details" asp-route-id="legacy-1874">View details</a><button type="button" class="btn btn-gold" data-enquiry="Legacy 1874">Submit enquiry</button></div></div></article></div>
		<div class="col-12 d-none" id="marketEmpty"><div class="empty-state">No sample listings match those filters.</div></div>
	</div>
</div></section>
@section Scripts { <script src="~/js/catalog.js" asp-append-version="true"></script> }
