@{
	ViewData["Title"] = "Application tracking demonstration";
}
<section class="page-hero page-hero-compact"><div class="container"><p class="eyebrow">APPLICATION TRACKING</p><h1>Track a sample application</h1><p>Search fictional reference records and see their demonstration status.</p></div></section>
<section class="section-space"><div class="container tracking-container"><div class="notice-bar mb-4">All records on this page are demonstration data and are not linked to any real application or authority.</div><form id="trackingForm" class="tracking-search"><div><label class="form-label" for="referenceNumber">Application reference number</label><input id="referenceNumber" class="form-control" placeholder="For example, AG-2026-1048" required /></div><button class="btn btn-navy" type="submit">Check status</button></form><div class="form-feedback" id="trackingFeedback" role="status" aria-live="polite"></div>
	<div class="tracking-result" id="trackingResult" hidden><div class="d-flex justify-content-between flex-wrap gap-2"><div><p class="eyebrow">DEMONSTRATION RECORD</p><h2 id="trackingType"></h2></div><span id="trackingStatus" class="status-pill"></span></div><div class="tracking-meta"><div><span>Reference</span><strong id="trackingReference"></strong></div><div><span>Submitted</span><strong id="trackingDate"></strong></div></div><p id="trackingDetails"></p><div class="status-steps" aria-label="Example application milestones"><span>Submitted</span><span>Under review</span><span>Outcome</span></div></div>
	<div class="sample-records"><h2>Sample reference numbers</h2><div class="row g-3"><div class="col-sm-6 col-lg"><button class="sample-ref" type="button" data-reference="AG-2026-1048"><strong>AG-2026-1048</strong><span>Submitted</span></button></div><div class="col-sm-6 col-lg"><button class="sample-ref" type="button" data-reference="AG-2026-1052"><strong>AG-2026-1052</strong><span>Under Review</span></button></div><div class="col-sm-6 col-lg"><button class="sample-ref" type="button" data-reference="AG-2026-1061"><strong>AG-2026-1061</strong><span>Further Information Required</span></button></div><div class="col-sm-6 col-lg"><button class="sample-ref" type="button" data-reference="AG-2026-1074"><strong>AG-2026-1074</strong><span>Approved for Further Processing</span></button></div><div class="col-sm-6 col-lg"><button class="sample-ref" type="button" data-reference="AG-2026-1080"><strong>AG-2026-1080</strong><span>Rejected</span></button></div></div></div>
	<a class="btn btn-outline-navy mt-4" asp-controller="Home" asp-action="Index">Back to home</a>
</div></section>
@section Scripts { <script src="~/js/site.js" asp-append-version="true"></script> }
