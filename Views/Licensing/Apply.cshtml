@{
	ViewData["Title"] = "Licensing information request";
}
<section class="page-hero page-hero-compact"><div class="container"><p class="eyebrow">LICENSING INFORMATION</p><h1>Start an application enquiry</h1><p>Share basic contact details to demonstrate a future application workflow.</p></div></section>
<section class="section-space"><div class="container form-page-grid"><div class="form-panel"><form id="licensingForm" novalidate>
	<div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="applicantName">Applicant name</label><input class="form-control" id="applicantName" required autocomplete="name" /></div><div class="col-md-6 mb-3"><label class="form-label" for="applicantEmail">Email</label><input class="form-control" id="applicantEmail" type="email" required autocomplete="email" /></div></div>
	<div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="contactNumber">Contact number</label><input class="form-control" id="contactNumber" type="tel" required autocomplete="tel" /></div><div class="col-md-6 mb-3"><label class="form-label" for="applicationCategory">Application category</label><select class="form-select" id="applicationCategory" required><option value="">Choose a category</option><option>General information</option><option>Sporting use information</option><option>Historical item information</option><option>Renewal information</option></select></div></div>
	<div class="mb-3"><label class="form-label" for="generalId">General identification information <span class="optional-label">(non-sensitive)</span></label><input class="form-control" id="generalId" placeholder="For example, applicant reference from your local process" /><div class="form-text">Do not enter government ID numbers or attach documents in this demonstration.</div></div>
	<div class="mb-3"><label class="form-label" for="applicantAddress">Address</label><textarea class="form-control" id="applicantAddress" rows="2" required autocomplete="street-address"></textarea></div>
	<div class="mb-3"><label class="form-label" for="applicationReason">Reason for enquiry</label><textarea class="form-control" id="applicationReason" rows="4" required minlength="10"></textarea></div>
	<div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="applicationDeclaration" required /><label class="form-check-label" for="applicationDeclaration">I understand this is a demonstration request and not a government application.</label></div>
	<div class="form-feedback" id="licensingFeedback" role="status" aria-live="polite"></div><button class="btn btn-navy" type="submit">Submit information request</button>
</form></div><aside class="side-note"><h2>Important</h2><p>Submitting this demonstration form does not issue a government license, establish eligibility, or guarantee approval.</p><p>ArmsGuard is not a licensing authority. Confirm all requirements through the appropriate official agency in your jurisdiction.</p><a asp-controller="Licensing" asp-action="Tracking">View sample tracking records →</a></aside></div></section>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script> }
